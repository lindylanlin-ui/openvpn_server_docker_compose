# OpenVPN 對外連線用的公開 IP 或 DDNS 網域名稱。
OVPN_HOSTNAME_OR_IP=vpn.example.com

# OpenVPN 對外通訊協定，家用環境通常使用 udp。
OVPN_PROTO=udp

# Router 要轉發到這台 OpenVPN 主機的外部連接埠。
OVPN_PORT=1194

# VPN client 連線後要拿到的虛擬網段。
OVPN_NETWORK=10.8.0.0/24

# 你家裡實體 LAN 的網段，client 連回家後會透過它存取 NAS、桌機等設備。
# 請填「網段」不是單一主機 IP，例如 192.168.4.0/24。
OVPN_LAN_SUBNET=192.168.4.0/24

# client 連上 VPN 後要使用的 DNS。
# 如果你只在乎穩定上網，可維持公用 DNS；
# 如果你要解析家中設備的內網主機名稱，可改成家中 router、Pi-hole 或 NAS DNS。
OVPN_DNS_SERVERS=1.1.1.1,1.0.0.1

# 建立 CA / server 憑證時使用的 Common Name。
OVPN_SERVER_CN=MyOpenVPN

# 是否允許不同 VPN client 彼此互通。家用情境預設關閉即可。
OVPN_CLIENT_TO_CLIENT=false
